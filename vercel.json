{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": ".",
  "regions": ["fra1"],
  "rewrites": [
    { "source": "/s/:id", "destination": "/stints" }
  ],
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
